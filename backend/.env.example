# Copy this file to .env and fill in your values

# ── Database ─────────────────────────────────────────────────────────────────
# Vercel Postgres — auto-filled by Vercel when you link a Postgres database
# (Dashboard → Storage → Create Database → connect to project)
POSTGRES_URL=postgres://...

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Sign up free at https://resend.com → API Keys → Create Key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Where booking notifications are sent (owner's email)
OWNER_EMAIL=cauveryresorts@gmail.com

# ── Admin Dashboard ───────────────────────────────────────────────────────────
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_SECRET=any-long-random-string-for-token-signing

# ── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://www.cauveryresorts.com

# ── Local dev only (Vercel sets PORT automatically) ──────────────────────────
PORT=3000
